      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The full URL to submit for indexing"
        },
        "action": {
          "type": "string",
          "enum": [
            "URL_UPDATED",
            "URL_DELETED"
          ],
          "default": "URL_UPDATED",
          "description": "URL_UPDATED for new/changed content, URL_DELETED for removed pages"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
