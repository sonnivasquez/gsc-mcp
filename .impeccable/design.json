      "refersTo": "navigation-link",
      "description": "The same midnight navigation and ice install action appear across routes.",
      "html": "<header class=\"ds-site-header\"><nav aria-label=\"Primary\"><a class=\"ds-site-brand\" href=\"/\">GSC MCP</a><div class=\"ds-site-links\"><a class=\"ds-site-link\" href=\"/#use-cases\">Use cases</a><a class=\"ds-site-link\" href=\"/#tools\">Tools</a><a class=\"ds-site-link\" href=\"/docs\" aria-current=\"page\">Docs</a></div><button class=\"ds-github\">GitHub</button><a class=\"ds-install\" href=\"/docs\">Get started</a></nav></header>",
      "css": ".ds-site-header{border-bottom:1px solid var(--color-line);background:var(--color-paper);color:var(--color-ink);font-family:var(--font-sans)}.ds-site-header nav{display:flex;min-height:88px;width:min(calc(100% - 64px),1120px);align-items:center;gap:36px;margin:0 auto}.ds-site-brand{display:inline-flex;min-height:44px;align-items:center;color:var(--color-ink);font-size:15px;font-weight:700;letter-spacing:-.025em;text-decoration:none}.ds-site-links{display:flex;gap:4px}.ds-site-link{display:inline-flex;min-height:44px;align-items:center;padding:8px 12px;color:var(--color-ink-soft);font-size:13px;text-decoration:none;text-underline-offset:6px;text-decoration-thickness:1px;transition:color 180ms}.ds-site-link:hover,.ds-site-link:focus-visible,.ds-site-link[aria-current=\"page\"]{color:var(--color-ink);text-decoration:underline;text-decoration-color:var(--color-cobalt)}.ds-site-link[aria-current=\"page\"]{font-weight:600}.ds-github{display:inline-flex;min-height:44px;align-items:center;justify-content:center;margin-left:auto;padding:0 15px;border:1px solid var(--color-line);border-radius:var(--ds-radius-sm);background:transparent;color:var(--color-ink);font:400 13px var(--font-sans)}.ds-install{display:inline-flex;min-height:44px;align-items:center;padding:0 16px;border-radius:var(--ds-radius-sm);background:var(--ds-action-surface);color:var(--ds-action-ink);font-size:14px;font-weight:600;text-decoration:none;transition:background-color 180ms}.ds-install:hover{background:var(--ds-action-hover)}.ds-site-header :focus-visible{outline:2px solid var(--color-cobalt);outline-offset:3px}@media(max-width:767px){.ds-site-header nav{min-height:72px;gap:16px}}"
    },
    {
      "name": "Guide navigation rail",
      "kind": "nav",
      "refersTo": "guide-navigation-link",
      "description": "A quiet left rail with a cyan marker for the active guide.",
      "html": "<nav class=\"ds-guide-nav\" aria-label=\"Guide pages\"><p>Guides</p><a href=\"/docs\">Installation<span>Connect a client</span></a><a href=\"/docs/credentials\" aria-current=\"page\">Credentials<span>Choose an access mode</span></a></nav>",
      "css": ".ds-guide-nav{position:sticky;top:5.5rem;font-family:var(--font-sans)}.ds-guide-nav>p{color:var(--color-ink-faint);font:400 12px/1.5 var(--font-mono);letter-spacing:.12em;text-transform:uppercase}.ds-guide-nav a{display:block;min-height:48px;margin-inline-start:-1px;padding:12px 20px;border-inline-start:1px solid transparent;color:var(--color-ink-soft);font-size:14px;line-height:1.4;text-decoration:none;transition:color 180ms,border-color 180ms}.ds-guide-nav a span{display:block;margin-top:2px;color:var(--color-ink-faint);font-size:12px}.ds-guide-nav a:hover,.ds-guide-nav a:focus-visible,.ds-guide-nav a[aria-current=\"page\"]{color:var(--color-ink);border-inline-start-color:var(--color-cobalt)}.ds-guide-nav a[aria-current=\"page\"]{font-weight:600}.ds-guide-nav :focus-visible{outline:2px solid var(--color-cobalt);outline-offset:3px}"
    },
    {
      "name": "Terminal command panel",
      "kind": "custom",
      "refersTo": "command-panel",
      "description": "A bordered terminal surface with a separate command label and copy action.",
      "html": "<section class=\"ds-command-panel\"><header class=\"ds-command-heading\"><p class=\"ds-command-title\">Setup with npm</p><button class=\"ds-panel-copy\">Copy</button></header><pre class=\"ds-command-pre\" tabindex=\"0\"><code>npx gsc-mcp setup --client codex</code></pre></section>",
      "css": ".ds-command-panel{overflow:hidden;border:1px solid var(--color-panel-line);border-radius:var(--ds-radius-lg);background:var(--color-panel);color:var(--color-ink)}.ds-command-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:6px 16px;border-bottom:1px solid var(--color-panel-line)}.ds-command-title{margin:0;color:var(--color-panel-soft);font:400 12px/1.5 var(--font-mono)}.ds-panel-copy{min-height:44px;padding:0 16px;border:1px solid var(--color-panel-line);border-radius:var(--ds-radius-sm);background:transparent;color:#fff;font:600 13px var(--font-sans);cursor:pointer}.ds-panel-copy:hover{background:rgba(255,255,255,.1)}.ds-panel-copy:focus-visible{outline:2px solid var(--color-focus-on-dark);outline-offset:3px}.ds-command-pre{margin:0;overflow-x:auto;padding:12px 16px;color:#fff;font:400 13px/1.65 var(--font-mono);overscroll-behavior-inline:contain;scrollbar-width:thin}.ds-command-pre code{white-space:pre}.ds-command-pre:focus-visible{outline:2px solid var(--color-focus-on-dark);outline-offset:-3px}"
    },
    {
      "name": "Documentation runtime tabs",
      "kind": "custom",
      "refersTo": "tab-underline",
      "description": "Underlined runtime selection with a cyan active edge.",
      "html": "<div class=\"ds-runtime-tabs\" role=\"tablist\" aria-label=\"Runtime\"><button role=\"tab\">Node</button><button role=\"tab\" aria-selected=\"true\">Hermes</button></div>",
      "css": ".ds-runtime-tabs{display:flex;width:fit-content;gap:4px;border-bottom:1px solid var(--color-line);font-family:var(--font-sans)}.ds-runtime-tabs button{min-height:44px;padding:8px 12px;border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--color-ink-soft);font:400 14px var(--font-sans);cursor:pointer}.ds-runtime-tabs button[aria-selected=\"true\"]{border-bottom-color:var(--color-cobalt);color:var(--color-cobalt-deep);font-weight:600}.ds-runtime-tabs button:hover{color:var(--color-ink)}.ds-runtime-tabs button:focus-visible{outline:2px solid var(--color-cobalt);outline-offset:3px}"
    },
    {
      "name": "Illustrative evidence card",
      "kind": "card",
      "refersTo": "conversation-card",
      "description": "A homepage example that keeps the question, answer and data together.",
      "html": "<figure class=\"ds-conversation\"><figcaption>Codex <small>Illustrative example</small></figcaption><p class=\"ds-prompt\">Compare the last 28 days for sc-domain:example.com.</p><p class=\"ds-answer\">Clicks increased in this sample.</p><code class=\"ds-tool\">gsc_compare_periods</code><div class=\"ds-table-wrap\"><table><caption>Sample data for example.com</caption><thead><tr><th>Metric</th><th>Current</th><th>Previous</th></tr></thead><tbody><tr><th>Clicks</th><td>12,540</td><td>10,200</td></tr><tr><th>Impressions</th><td>245,231</td><td>210,400</td></tr></tbody></table></div></figure>",
      "css": ".ds-conversation{margin:0;padding:18px;border:1px solid var(--color-line);border-radius:var(--ds-radius-lg);background:var(--color-card);color:var(--color-ink);font:400 13px/1.7 var(--font-sans)}.ds-conversation figcaption{display:flex;justify-content:space-between;gap:8px;color:var(--home-conversation-label,#d1dfe9);font-size:12px}.ds-conversation small{color:var(--color-ink-faint);font-size:12px}.ds-prompt{margin:14px 0 16px;padding:11px 13px;border-radius:5px;background:var(--home-prompt-surface,#142735);color:var(--home-prompt-ink,#bdcddc);font:400 12px/1.75 var(--font-mono);overflow-wrap:anywhere}.ds-answer{margin:0 0 16px;color:var(--color-ink);font-size:13px}.ds-tool{color:var(--home-tool-ink,#d6e5ef);font:400 12px/1.65 var(--font-mono)}.ds-table-wrap{overflow-x:auto;margin-top:12px}.ds-conversation table{width:100%;border-collapse:collapse;color:var(--home-data-ink,#c5d8e6);font:400 12px/1.65 var(--font-mono);font-variant-numeric:tabular-nums;white-space:nowrap}.ds-conversation caption{margin:12px 0 4px;color:var(--color-ink-faint);font-size:12px;text-align:left}.ds-conversation th,.ds-conversation td{padding:6px 8px;text-align:right;font-weight:400}.ds-conversation th:first-child{text-align:left;padding-left:0}.ds-conversation thead{border-bottom:1px solid var(--color-line);color:var(--home-data-muted,#96adc0)}.ds-conversation tbody tr:nth-child(even){background:var(--home-row-surface,#101f2a)}"
    },
    {
      "name": "Warning note",
      "kind": "custom",
      "refersTo": "warning-note",
      "description": "A labelled warning on the shared dark surface.",
      "html": "<aside class=\"ds-warning\" role=\"note\"><strong>Testing mode</strong><span>Access may expire while the OAuth app remains in testing.</span></aside>",
      "css": ".ds-warning{display:flex;gap:12px;padding:12px 16px;border:1px solid var(--color-warn-line);border-radius:var(--ds-radius-md);background:var(--color-warn-bg);color:var(--color-warn-on-dark);font:400 14px/1.6 var(--font-sans)}.ds-warning strong{font-weight:600}.ds-warning:focus-visible{outline:2px solid var(--color-focus-on-dark);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Terminal SEO",
    "overview": "Terminal SEO makes Search Console work feel inspectable and calm. The homepage and internal guides share the same midnight canvas, cyan signals and ice actions. The guides extend that visual language with clear reading columns, persistent section navigation and terminal-like command panels.\n\nArchivo carries explanation, headings and navigation. JetBrains Mono marks commands, tool names and measured data. Keep prose conversational and readable; reserve monospaced type for material that benefits from a precise, fixed-width shape.",
    "keyCharacteristics": [
      "Midnight surfaces with a cyan signal and high-contrast ice actions.",
      "Archivo for explanation; JetBrains Mono for commands and measurements.",
      "Clear guide navigation and inspectable evidence close to its explanation.",
      "Rectangular controls, quiet borders and explicit keyboard focus."
    ],
    "rules": [
      {
        "name": "The Shared Canvas Rule",
        "body": "Homepage and internal routes use the same semantic canvas, card, text, line and cyan values. The home selector remains for prompt, table and status details that belong to its examples.",
        "section": "colors"
      },
      {
        "name": "The Border-and-Tone Rule",
        "body": "Preserve tonal and border separation before adding any raised treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared midnight, cyan and ice palette on homepage and internal routes.",
      "Do use Archivo for explanation and navigation, and JetBrains Mono for commands, tool names and measured data.",
      "Do keep guide prose within the article measure and place section navigation beside it on wide screens.",
      "Do preserve underlines for text-link state, visible focus, 44px copy targets and native keyboard behavior.",
      "Do label examples as illustrative and retain complete content when reduced motion is enabled.",
      "Do group each homepage use case with its evidence and let wide data scroll."
    ],
    "donts": [
      "Don't assign internal routes a separate page palette; they continue the shared Terminal SEO midnight system.",
      "Don't use white text on the cyan link color for primary actions; use the ice action surface with dark text.",
      "Don't turn command-copy controls into pills or add shadows to resting cards.",
      "Don't put an exterior card around the homepage FAQ or split an explanation from its evidence.",
      "Don't make status depend on color alone, shrink table data to force a fit, or hide full answers for motion effects.",
      "Don't change factual claims, publication status, privacy boundaries or permissions as a visual effect."
    ]
  }
}
