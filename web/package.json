{
  "name": "gsc-mcp-site",
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1"
  },
  "scripts": {
    "build": "bun --bun scripts/generate-sitemap.mjs && bunx --bun vite build",
    "build:node": "node scripts/generate-sitemap.mjs && node ./node_modules/vite/bin/vite.js build",
    "sitemap": "bun --bun scripts/generate-sitemap.mjs",
    "sitemap:node": "node scripts/generate-sitemap.mjs",
    "typecheck": "bunx --bun tsc --noEmit",
    "typecheck:node": "node ./node_modules/typescript/bin/tsc --noEmit",
    "design:sync": "bun --bun scripts/sync-design-tokens.mjs",
    "design:sync:node": "node scripts/sync-design-tokens.mjs",
    "design:check": "bun --bun scripts/sync-design-tokens.mjs --check",
    "design:check:node": "node scripts/sync-design-tokens.mjs --check",
    "dev": "node ./node_modules/vite/bin/vite.js dev --port 3000",
    "preview": "node ./node_modules/vite/bin/vite.js preview --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
